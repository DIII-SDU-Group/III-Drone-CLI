{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/ssh-bundle-transfer-v1.schema.json",
  "title": "III measured SSH bundle transfer result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release_id", "upload_id", "transfer_id", "endpoint", "expected_profile", "resumed", "bytes_total", "bytes_transferred", "elapsed_s", "target_s", "target_met", "content_addressed_optimization_justified", "optimization_assessment", "server_host_authentication", "logical_identity_checked", "physical_host_authenticated"],
  "properties": {
    "schema": {"const": "iii.ssh-bundle-transfer-result/v1"},
    "release_id": {"$ref": "#/definitions/hash"},
    "upload_id": {"$ref": "#/definitions/hash"},
    "transfer_id": {"$ref": "#/definitions/hash"},
    "endpoint": {"const": "iii-deploy@iii.local"},
    "expected_profile": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
    "resumed": {"type": "boolean"},
    "bytes_total": {"type": "integer", "minimum": 0},
    "bytes_transferred": {"type": "integer", "minimum": 0},
    "elapsed_s": {"type": "number", "minimum": 0},
    "target_s": {"const": 120.0},
    "target_met": {"type": "boolean"},
    "content_addressed_optimization_justified": {"type": "boolean"},
    "optimization_assessment": {"enum": ["not-justified-target-met", "not-justified-repeat-measurement-required"]},
    "server_host_authentication": {"const": "accepted-risk-none"},
    "logical_identity_checked": {"const": true},
    "physical_host_authenticated": {"const": false}
  },
  "definitions": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
