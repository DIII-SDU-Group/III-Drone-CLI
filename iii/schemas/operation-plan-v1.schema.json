{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iii-drone.invalid/schemas/operation-plan-v1.schema.json",
  "title": "III CLI operation plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation_id", "created_at", "command", "argv", "mutating", "context", "plan_id"],
  "properties": {
    "schema": {"const": "iii.cli-operation-plan/v1"},
    "operation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "command": {"type": "string", "minLength": 1},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "mutating": {"type": "boolean"},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "profile", "release_id"],
      "properties": {
        "target": {"type": ["string", "null"]},
        "profile": {"type": ["string", "null"]},
        "release_id": {"type": ["string", "null"]}
      }
    },
    "plan_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
